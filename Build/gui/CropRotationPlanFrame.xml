<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- In-game menu page (Esc) for FS25_CropRotationPlan. Uses only base game FS25 GUI profiles.
     Layout follows the base game / Courseplay / AdvancedDamageSystem sub-category pages:
     header, sub-tab bar (Settings, Plans, Field groups), one container per sub-tab.
     Row background colours are set in Lua (CropRotationPlanFrame:updateRowColors), like the
     base game settings page does; without that the rows render white.
     The Plans and Field groups containers are empty: those pages are drawn by
     CropRotationPlanFrame:draw (CropRotationPlanPages.lua) inside the container's area. -->
<GUI name="cropRotationPlan">
    <GuiElement profile="fs25_menuContainer" name="cropRotationPlan">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle"/>
        </GuiElement>

        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="tabSettings" onClick="onClickTabSettings">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="tabPlans" onClick="onClickTabPlans">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="tabGroups" onClick="onClickTabGroups">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging" position="0px -10px" onClick="updateSubCategoryPages"/>

        <!-- Sub-tab 1: Settings (mockup 1) -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subPageSettings">
            <ScrollingLayout profile="fs25_settingsLayout" id="settingsLayout" bottomClipperElementName="bottomClipper">

                <Text profile="fs25_settingsSectionHeader" name="sectionHeader" id="sectionDisplay"/>

                <Bitmap profile="fs25_multiTextOptionContainer">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="displayOption" onClick="onClickDisplay">
                        <Text profile="fs25_multiTextOptionTooltip" name="tooltip" id="displayTooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" id="displayTitle"/>
                </Bitmap>

                <Bitmap profile="fs25_multiTextOptionContainer">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="positionOption" onClick="onClickPosition">
                        <Text profile="fs25_multiTextOptionTooltip" name="tooltip" id="positionTooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" id="positionTitle"/>
                </Bitmap>

                <Bitmap profile="fs25_multiTextOptionContainer">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="keyOption">
                        <Text profile="fs25_multiTextOptionTooltip" name="tooltip" id="keyTooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" id="keyTitle"/>
                </Bitmap>

                <Text profile="fs25_settingsSectionHeader" name="sectionHeader" id="sectionCrops"/>

                <Bitmap profile="fs25_multiTextOptionContainer">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="grassOption" onClick="onClickGrass">
                        <Text profile="fs25_multiTextOptionTooltip" name="tooltip" id="grassTooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" id="grassTitle"/>
                </Bitmap>

                <Text profile="fs25_settingsSectionHeader" name="sectionHeader" id="sectionMultiplayer"/>

                <!-- Multiplayer only (hidden in single player): the switch, which only the farm
                     manager can change, and whether this player can edit -->
                <Bitmap profile="fs25_multiTextOptionContainer" id="editRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="editOption" onClick="onClickEditPermission">
                        <Text profile="fs25_multiTextOptionTooltip" name="tooltip" id="editTooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" id="editTitle"/>
                </Bitmap>

                <Bitmap profile="fs25_multiTextOptionContainer" id="editStatusRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="editStatusOption">
                        <Text profile="fs25_multiTextOptionTooltip" name="tooltip" id="editStatusTooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" id="editStatusTitle"/>
                </Bitmap>

            </ScrollingLayout>
            <Bitmap profile="fs25_settingsTooltipSeparator" name="separator"/>
            <Bitmap profile="fs25_stopClipper" name="bottomClipper"/>
        </GuiElement>

        <!-- Sub-tab 2: Plans (mockups 2 and 4), drawn in Lua -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subPagePlans"/>

        <!-- Sub-tab 3: Field groups (mockup 3), drawn in Lua -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subPageGroups"/>
    </GuiElement>
</GUI>
